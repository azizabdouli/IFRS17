/* ================================================= */
/* 🎨 APP COMPONENT - LAYOUT PRINCIPAL */
/* ================================================= */

.ifrs17-app {
  min-height: 100vh;
  background: var(--ifrs17-bg-primary);
  font-family: var(--ifrs17-font-family);
}

.main-content {
  min-height: calc(100vh - 80px); /* Hauteur totale moins header */
  background: var(--ifrs17-bg-primary);
}

/* Styles pour les pages d'authentification */
:host-context(.auth-page) {
  .ifrs17-app {
    background: transparent; /* Laisser le fond d'auth gérer le background */
  }
  
  app-header {
    display: none; /* Masquer le header sur les pages d'auth */
  }
  
  .main-content {
    min-height: 100vh;
  }
}